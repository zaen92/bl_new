{
  "name": "jaeinit-blog-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "emulators": "bash scripts/firebase-local.sh emulators:start --project demo-jaeinit --only auth,firestore,functions,storage",
    "test": "bash scripts/firebase-local.sh emulators:exec --project demo-jaeinit --only auth,firestore,functions,storage \"node --test --test-reporter=tap --test-timeout=90000 --test-concurrency=1 tests/*.test.js\"",
    "test:ui": "playwright test",
    "seed": "node scripts/seed-packages.js",
    "test:unit": "node --test --test-reporter=tap tests/unit.test.js tests/emulator-cache.test.js",
    "test:auth": "bash scripts/test-auth.sh",
    "emulators:prepare": "node scripts/prepare-emulators.mjs",
    "emulators:check": "node scripts/prepare-emulators.mjs --check",
    "test:step2:unit": "node --test --test-reporter=tap tests/ai-provider.test.js",
    "test:step2:e2e": "bash scripts/test-step2-browser.sh"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.24.0",
    "node": "22.23.4",
    "vite": "^7.2.0"
  }
}
