rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  // Firebase's REST metadata/media endpoint can mint public download tokens even
  // on an authenticated read. All browser access is therefore denied. Verified
  // owners receive photo bytes only through getPost/getGeneration, whose Admin
  // reads do not mint tokens and enforce current Auth state and ownership.
  match /{path=**} {allow read,write: if false;}
 }
}
