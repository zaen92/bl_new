# Firebase web configuration is public; never put provider/PG secrets here.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-jaeinit.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-jaeinit
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true

# Optional public reCAPTCHA v3 site key; no server secret.
VITE_APPCHECK_SITE_KEY=
